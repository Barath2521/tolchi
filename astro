<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jyotisha — Vedic Birth Chart &amp; Dasha Calculator</title>
<style>
  :root{
    --ink:#141126;
    --sky-1:#181433;
    --sky-2:#0f0c22;
    --gold:#c9a463;
    --gold-bright:#e4c584;
    --sindoor:#a8453f;
    --parchment:#efe7d6;
    --parchment-dim:#d9cfb6;
    --lavender:#b3aad0;
    --line: rgba(201,164,99,0.28);
    --good:#7fa876;
    --bad:#b56a5a;
    --neutral:#b3aad0;
    --font-display: Georgia, "Iowan Old Style", "Palatino Linotype", "Times New Roman", serif;
    --font-body: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --font-data: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(ellipse at 20% -10%, rgba(201,164,99,0.10), transparent 45%),
      radial-gradient(ellipse at 100% 0%, rgba(168,69,63,0.10), transparent 40%),
      linear-gradient(180deg, var(--sky-1), var(--sky-2) 60%);
    color: var(--parchment);
    font-family: var(--font-body);
    min-height:100vh;
    line-height:1.5;
  }
  .wrap{max-width:960px;margin:0 auto;padding:28px 20px 80px;}

  /* ---------- Header / signature ---------- */
  header.hero{
    position:relative;
    text-align:center;
    padding:36px 10px 26px;
    overflow:hidden;
  }
  .wheel{
    position:absolute; top:-90px; left:50%; transform:translateX(-50%);
    width:420px; height:420px;
    border-radius:50%;
    border:1px dashed var(--line);
    display:flex; align-items:center; justify-content:center;
    animation: spin 180s linear infinite;
    pointer-events:none;
  }
  .wheel .glyphs{position:relative; width:100%; height:100%;}
  .wheel .glyphs span{
    position:absolute; top:50%; left:50%;
    width:26px; height:26px; margin:-13px;
    display:flex; align-items:center; justify-content:center;
    font-size:15px; color:var(--gold); opacity:0.55;
    transform-origin:center;
  }
  @keyframes spin{ to{ transform:translateX(-50%) rotate(360deg); } }
  @media (prefers-reduced-motion: reduce){ .wheel{ animation:none; } }

  header.hero .eyebrow{
    letter-spacing:0.22em; text-transform:uppercase; font-size:11px;
    color:var(--gold); margin-bottom:10px; position:relative;
  }
  header.hero h1{
    font-family:var(--font-display); font-weight:600; font-size:clamp(30px,5vw,44px);
    margin:0; color:var(--parchment); position:relative; letter-spacing:0.01em;
  }
  header.hero h1 em{ color:var(--gold-bright); font-style:normal; }
  header.hero p.sub{
    max-width:520px; margin:12px auto 0; color:var(--lavender); font-size:14.5px; position:relative;
  }

  /* ---------- Cards ---------- */
  .card{
    background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.015));
    border:1px solid var(--line);
    border-radius:10px;
    padding:22px 22px 24px;
    margin-bottom:18px;
  }
  .card h2{
    font-family:var(--font-display); font-size:20px; margin:0 0 4px; color:var(--gold-bright); font-weight:600;
  }
  .card .hint{ color:var(--lavender); font-size:13px; margin:0 0 18px; }

  /* ---------- Form ---------- */
  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .field{ display:flex; flex-direction:column; gap:6px; margin-bottom:14px; }
  .field label{ font-size:12.5px; color:var(--lavender); letter-spacing:0.03em; }
  input, select{
    background: rgba(0,0,0,0.25);
    border:1px solid var(--line);
    color:var(--parchment);
    border-radius:6px;
    padding:10px 11px;
    font-size:14.5px;
    font-family:var(--font-body);
    outline:none;
  }
  input::placeholder{ color:#6f6a8c; }
  input:focus, select:focus{ border-color:var(--gold); box-shadow:0 0 0 3px rgba(201,164,99,0.18); }
  select option{ background:#1b1738; color:var(--parchment); }
  .city-results{
    position:relative;
  }
  .city-dropdown{
    position:absolute; z-index:5; top:calc(100% + 4px); left:0; right:0;
    background:#1c1839; border:1px solid var(--line); border-radius:8px;
    max-height:220px; overflow-y:auto; display:none;
  }
  .city-dropdown.open{ display:block; }
  .city-dropdown div{ padding:8px 12px; font-size:13.5px; cursor:pointer; border-bottom:1px solid rgba(255,255,255,0.05); }
  .city-dropdown div:hover{ background:rgba(201,164,99,0.15); }
  details.advanced{ margin-top:4px; }
  details.advanced summary{
    cursor:pointer; color:var(--gold); font-size:13px; letter-spacing:0.02em; margin-bottom:10px;
  }
  .btn{
    display:inline-block; border:none; cursor:pointer;
    background: linear-gradient(180deg, var(--gold-bright), var(--gold));
    color:#231a0a; font-weight:700; letter-spacing:0.02em;
    padding:12px 26px; border-radius:7px; font-size:14.5px; font-family:var(--font-body);
    margin-top:6px;
  }
  .btn:hover{ filter:brightness(1.06); }
  .btn.secondary{ background:transparent; border:1px solid var(--gold); color:var(--gold); font-weight:600; padding:8px 16px; }
  .error{ color:var(--bad); font-size:13px; margin-top:8px; display:none; }

  /* ---------- Results ---------- */
  #results{ display:none; }
  .summary-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:6px; }
  .summary-item{
    border:1px solid var(--line); border-radius:8px; padding:14px 14px 12px; background:rgba(0,0,0,0.18);
  }
  .summary-item .k{ font-size:11px; text-transform:uppercase; letter-spacing:0.09em; color:var(--gold); margin-bottom:6px; }
  .summary-item .v{ font-family:var(--font-display); font-size:19px; color:var(--parchment); }
  .summary-item .v2{ font-size:12.5px; color:var(--lavender); margin-top:2px; }

  /* Chart */
  .chart-wrap{ display:flex; gap:22px; flex-wrap:wrap; align-items:flex-start; }
  .rasi-chart{
    display:grid; grid-template-columns:repeat(4,1fr); grid-template-rows:repeat(4,1fr);
    width:320px; height:320px; border:1px solid var(--gold); border-radius:4px; overflow:hidden; flex:none;
  }
  .rasi-cell{
    border:1px solid var(--line); padding:5px 6px; font-size:11px; position:relative; display:flex; flex-direction:column;
  }
  .rasi-cell .sign{ color:var(--gold); font-size:11.5px; margin-bottom:3px; }
  .rasi-cell .planets{ color:var(--parchment); font-family:var(--font-data); font-size:11.5px; line-height:1.5; flex:1; }
  .rasi-cell.asc{ background:rgba(201,164,99,0.10); }
  .rasi-cell .asc-tag{ position:absolute; bottom:4px; right:6px; color:var(--sindoor); font-size:10px; font-weight:700; }
  .rasi-center{ grid-column:2 / span 2; grid-row:2 / span 2; display:flex; align-items:center; justify-content:center; flex-direction:column; border:1px solid var(--line); }
  .rasi-center .om{ font-size:30px; color:var(--gold); opacity:0.6; }
  .rasi-center .cap{ font-family:var(--font-display); font-size:12px; color:var(--lavender); margin-top:4px; text-align:center; padding:0 8px;}

  .legend{ font-size:12px; color:var(--lavender); flex:1; min-width:220px; }
  .legend table{ border-collapse:collapse; width:100%; }
  .legend td{ padding:3px 6px; }
  .legend td.g{ color:var(--gold); font-family:var(--font-data); width:34px; }

  table.data{ width:100%; border-collapse:collapse; font-size:13.5px; }
  table.data th{ text-align:left; color:var(--gold); font-weight:600; padding:8px 8px; border-bottom:1px solid var(--line); font-size:11.5px; text-transform:uppercase; letter-spacing:0.05em; }
  table.data td{ padding:8px 8px; border-bottom:1px solid rgba(255,255,255,0.06); font-family:var(--font-data); font-size:13px; }
  table.data tr.current td{ background:rgba(201,164,99,0.10); }
  .tag{ display:inline-block; padding:1px 7px; border-radius:20px; font-size:11px; font-family:var(--font-body); }
  .tag.good{ background:rgba(127,168,118,0.18); color:var(--good); }
  .tag.bad{ background:rgba(181,106,90,0.18); color:var(--bad); }
  .tag.neutral{ background:rgba(179,170,208,0.16); color:var(--lavender); }
  .tag.retro{ background:rgba(168,69,63,0.2); color:var(--sindoor); }

  .prose{ font-size:14.5px; color:var(--parchment); }
  .prose p{ margin:0 0 12px; }
  .prose strong{ color:var(--gold-bright); }

  .antardasha-list{ margin-top:14px; padding-left:0; list-style:none; font-size:13px; }
  .antardasha-list li{ display:flex; justify-content:space-between; padding:6px 4px; border-bottom:1px dotted rgba(255,255,255,0.08); }
  .antardasha-list li.current{ color:var(--gold-bright); font-weight:600; }

  footer{ text-align:center; color:var(--lavender); font-size:12px; margin-top:30px; opacity:0.8; }
  footer a{ color:var(--gold); }

  @media (max-width:640px){
    .grid2{ grid-template-columns:1fr; }
    .summary-grid{ grid-template-columns:1fr 1fr; }
    .rasi-chart{ width:100%; height:auto; aspect-ratio:1/1; }
    .rasi-cell{ font-size:10px; }
  }

  .analysis-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:14px}
  .mini-card{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:15px}
  .mini-card h3{margin:0 0 9px;font-family:var(--font-display);font-size:16px;color:var(--gold-bright)}
  .score{font-size:28px;font-weight:700;color:var(--gold-bright)}
  .muted{color:var(--lavender);font-size:12px;line-height:1.55}
  .pill{display:inline-block;border:1px solid rgba(201,164,99,.35);border-radius:999px;padding:3px 8px;margin:2px;font-size:11px}
  .topic{margin:10px 0 0;padding:11px 12px;border-left:2px solid var(--gold);background:rgba(201,164,99,.055);border-radius:0 8px 8px 0}
  @media(max-width:760px){.analysis-grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="wrap">

  <header class="hero">
    <div class="wheel"><div class="glyphs" id="zodiacWheel"></div></div>
    <div class="eyebrow">Jyotisha · जन्म कुंडली</div>
    <h1>Vedic <em>Birth Chart</em> &amp; Dasha Reader</h1>
    <p class="sub">Enter a date, time and place of birth. The engine computes true sidereal planetary positions (Lahiri ayanamsa), the ascendant, nakshatra, Vimshottari dasha timeline and today's transits — from first-principles orbital mechanics, not a lookup table.</p>
  </header>

  <div class="card">
    <h2>Birth details</h2>
    <p class="hint">Time and place matter — they fix the Ascendant (Lagna) and houses. If exact birth time is unknown, positions of signs/planets will still be correct, but the Ascendant and house placements will not be reliable.</p>

    <div class="grid2">
      <div class="field">
        <label for="fName">Name (optional)</label>
        <input id="fName" type="text" placeholder="For your reference">
      </div>
      <div class="field">
        <label for="fDate">Date of birth</label>
        <input id="fDate" type="date">
      </div>
    </div>

    <div class="grid2">
      <div class="field">
        <label for="fTime">Time of birth</label>
        <input id="fTime" type="time" step="60">
      </div>
      <div class="field city-results">
        <label for="fCity">Place of birth</label>
        <input id="fCity" type="text" placeholder="Start typing a city…" autocomplete="off">
        <div class="city-dropdown" id="cityDropdown"></div>
      </div>
    </div>

    <details class="advanced" id="advDetails">
      <summary>Advanced — coordinates &amp; UTC offset (auto-filled from city, editable)</summary>
      <div class="grid2">
        <div class="field">
          <label for="fLat">Latitude (° , north positive)</label>
          <input id="fLat" type="number" step="0.0001" placeholder="e.g. 13.0827">
        </div>
        <div class="field">
          <label for="fLon">Longitude (° , east positive)</label>
          <input id="fLon" type="number" step="0.0001" placeholder="e.g. 80.2707">
        </div>
      </div>
      <div class="field" style="max-width:220px;">
        <label for="fTz">UTC offset at birth (hours)</label>
        <input id="fTz" type="number" step="0.25" placeholder="e.g. 5.5">
      </div>
      <p class="hint" style="margin-bottom:0;">Standard-time offset for the selected city today. For places/dates with historical daylight-saving or a different zone in effect, adjust this manually.</p>
    </details>

    <button class="btn" id="btnCompute">Generate horoscope</button>
    <p class="hint" id="engineStatus">High-precision Swiss Ephemeris is loading…</p>
    <div class="error" id="formError"></div>
  </div>

  <div id="results">

    <div class="card">
      <h2>At a glance</h2>
      <div class="summary-grid" id="summaryGrid"></div>
    </div>

    <div class="card">
      <h2>Birth chart — Rāśi Chakra</h2>
      <p class="hint">South Indian style square chart. Sign positions are fixed; planets are placed by sidereal (Lahiri) longitude. <span style="color:var(--sindoor)">Asc</span> marks the ascendant sign.</p>
      <div class="chart-wrap">
        <div class="rasi-chart" id="rasiChart"></div>
        <div class="legend">
          <table id="legendTable"></table>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Planetary positions</h2>
      <p class="hint">Sidereal longitudes, Lahiri ayanamsa. House numbers use the whole-sign system from the ascendant.</p>
      <div style="overflow-x:auto;">
        <table class="data" id="planetTable"></table>
      </div>
    </div>

    <div class="card">
      <h2>Character notes</h2>
      <div class="prose" id="predictionText"></div>
    </div>

    <div class="card">
      <h2>Chart strength &amp; structure</h2>
      <p class="hint">A rule-based Jyotisha analysis: dignity, house lords, graha dṛṣṭi, combustion, Navāṁśa and selected yogas. These are interpretive indicators, not guarantees.</p>
      <div class="analysis-grid" id="structureGrid"></div>
    </div>

    <div class="card">
      <h2>Navāṁśa — D9</h2>
      <p class="hint">Each planet's D9 sign is calculated from its sidereal longitude using the standard 9-part divisional mapping.</p>
      <div style="overflow-x:auto;"><table class="data" id="d9Table"></table></div>
    </div>

    <div class="card">
      <h2>Graha dṛṣṭi — planetary aspects</h2>
      <p class="hint">Classical whole-sign aspects are shown from the natal chart. Mars, Jupiter and Saturn receive their special aspects in addition to the 7th aspect.</p>
      <div style="overflow-x:auto;"><table class="data" id="aspectTable"></table></div>
    </div>

    <div class="card">
      <h2>Life-area reading</h2>
      <p class="hint">The engine combines relevant houses, their lords, planetary strength and the current Dasha rather than using a single sign-based paragraph.</p>
      <div id="lifeReading"></div>
    </div>

    <div class="card">
      <h2>Vimshottari Dasha</h2>
      <p class="hint">120-year planetary period cycle, sequenced from the Moon's nakshatra at birth. Current period is highlighted.</p>
      <div style="overflow-x:auto;">
        <table class="data" id="dashaTable"></table>
      </div>
      <div id="antardashaBox"></div>
    </div>

    <div class="card">
      <h2>Transits today — Gochara</h2>
      <p class="hint" id="transitAsOf"></p>
      <div style="overflow-x:auto;">
        <table class="data" id="transitTable"></table>
      </div>
      <div id="sadeSatiBox" class="prose" style="margin-top:12px;"></div>
    </div>

  </div>

  <footer>
    Positions are computed with standard low-precision orbital-element formulas (accurate to roughly
    1 arc-minute for most planets), Lahiri ayanamsa, and the mean lunar node for Rahu/Ketu. This is
    good enough for correct sign, nakshatra and dasha determination in the great majority of cases,
    but is not the arc-second precision of a full ephemeris (e.g. Swiss Ephemeris) — for a chart within
    a minute or two of a sign/nakshatra boundary, or for major decisions, cross-check with a professional
    astrologer or dedicated ephemeris software. This tool is for reflection and study, not a substitute
    for your own judgment.
  </footer>

</div>

<script type="module">
  // High-precision Swiss Ephemeris WASM engine. The pinned build keeps the app reproducible.
  import SwissEph from 'https://cdn.jsdelivr.net/gh/prolaxu/swisseph-wasm@v0.1.0/src/swisseph.js';
  window.swissReady = (async () => {
    const swe = new SwissEph();
    await swe.initSwissEph();
    // Lahiri / Chitrapaksha ayanamsa for Vedic sidereal calculations.
    swe.set_sid_mode(swe.SE_SIDM_LAHIRI, 0, 0);
    window.swissEph = swe;
    return swe;
  })();
  window.addEventListener('beforeunload', () => { try { window.swissEph?.close(); } catch(e) {} });
</script>

<script>
/* ============================================================
   ASTRONOMY ENGINE  (validated against known reference points:
   Sun longitude vs Astronomical Almanac mean-longitude method;
   Karka->Simha sankranti timing mid-Aug; ascendant formula
   checked against first-principles equatorial rising-point cases)
   ============================================================ */
const DEG = Math.PI/180, RAD = 180/Math.PI;
function sinD(x){return Math.sin(x*DEG);}
function cosD(x){return Math.cos(x*DEG);}
function tanD(x){return Math.tan(x*DEG);}
function atan2d(y,x){return Math.atan2(y,x)*RAD;}
function rev(x){return x-Math.floor(x/360)*360;}

function julianDay(year,month,day,hourUT){
  let Y=year, M=month;
  if(M<=2){Y-=1;M+=12;}
  const A=Math.floor(Y/100);
  const B=2-A+Math.floor(A/4);
  const JD0=Math.floor(365.25*(Y+4716))+Math.floor(30.6001*(M+1))+day+B-1524.5;
  return JD0+hourUT/24;
}
function dFromJD(jd){ return jd-2451543.5; }

function keplerE(M,e){
  let E=M+e*RAD*sinD(M)*(1+e*cosD(M));
  for(let i=0;i<8;i++){
    const dM=M-(E-e*RAD*sinD(E));
    const dE=dM/(1-e*cosD(E));
    E+=dE;
    if(Math.abs(dE)<1e-9)break;
  }
  return E;
}
function heliocentric(N,i,w,a,e,M){
  const E=keplerE(M,e);
  const xv=a*(cosD(E)-e);
  const yv=a*Math.sqrt(1-e*e)*sinD(E);
  const v=atan2d(yv,xv);
  const r=Math.sqrt(xv*xv+yv*yv);
  const vw=v+w;
  const xh=r*(cosD(N)*cosD(vw)-sinD(N)*sinD(vw)*cosD(i));
  const yh=r*(sinD(N)*cosD(vw)+cosD(N)*sinD(vw)*cosD(i));
  const zh=r*(sinD(vw)*sinD(i));
  return {xh,yh,zh,r};
}
function sunPos(d){
  const w=rev(282.9404+4.70935e-5*d);
  const e=0.016709-1.151e-9*d;
  const M=rev(356.0470+0.9856002585*d);
  const E=keplerE(M,e);
  const xv=cosD(E)-e, yv=Math.sqrt(1-e*e)*sinD(E);
  const v=atan2d(yv,xv);
  const r=Math.sqrt(xv*xv+yv*yv);
  return {lon:rev(v+w), r, M, w};
}
function moonPos(d,sun){
  const N=rev(125.1228-0.0529538083*d);
  const i=5.1454;
  const w=rev(318.0634+0.1643573223*d);
  const a=60.2666, e=0.054900;
  const M=rev(115.3654+13.0649929509*d);
  const h=heliocentric(N,i,w,a,e,M);
  let lonecl=rev(atan2d(h.yh,h.xh));
  const Ms=sun.M, Mm=M, Nm=N, wm=w;
  const Ls=rev(Ms+sun.w);
  const Lm=rev(Mm+wm+Nm);
  const D=rev(Lm-Ls);
  const F=rev(Lm-Nm);
  let dLon=0;
  dLon+=-1.274*sinD(Mm-2*D);
  dLon+=0.658*sinD(2*D);
  dLon+=-0.186*sinD(Ms);
  dLon+=-0.059*sinD(2*Mm-2*D);
  dLon+=-0.057*sinD(Mm-2*D+Ms);
  dLon+=0.053*sinD(Mm+2*D);
  dLon+=0.046*sinD(2*D-Ms);
  dLon+=0.041*sinD(Mm-Ms);
  dLon+=-0.035*sinD(D);
  dLon+=-0.031*sinD(Mm+Ms);
  dLon+=-0.015*sinD(2*F-2*D);
  dLon+=0.011*sinD(Mm-4*D);
  lonecl=rev(lonecl+dLon);
  return {lon:lonecl};
}
function planetElements(name,d){
  switch(name){
    case 'mercury': return {N:rev(48.3313+3.24587e-5*d), i:7.0047+5.00e-8*d, w:rev(29.1241+1.01444e-5*d), a:0.387098, e:0.205635+5.59e-10*d, M:rev(168.6562+4.0923344368*d)};
    case 'venus': return {N:rev(76.6799+2.46590e-5*d), i:3.3946+2.75e-8*d, w:rev(54.8910+1.38374e-5*d), a:0.723330, e:0.006773-1.302e-9*d, M:rev(48.0052+1.6021302244*d)};
    case 'mars': return {N:rev(49.5574+2.11081e-5*d), i:1.8497-1.78e-8*d, w:rev(286.5016+2.92961e-5*d), a:1.523688, e:0.093405+2.516e-9*d, M:rev(18.6021+0.5240207766*d)};
    case 'jupiter': return {N:rev(100.4542+2.76854e-5*d), i:1.3030-1.557e-7*d, w:rev(273.8777+1.64505e-5*d), a:5.20256, e:0.048498+4.469e-9*d, M:rev(19.8950+0.0830853001*d)};
