};
function getCityTimezone(city,country){ const v=CITY_TZ[country]; return typeof v==='string'?v:(v&&v[city])||null; }
function offsetForTimeZone(dateParts,timeZone){
  if(!timeZone) return null;
  const guess=Date.UTC(dateParts[0],dateParts[1]-1,dateParts[2],dateParts[3],dateParts[4],0);
  const parts=new Intl.DateTimeFormat('en-US',{timeZone,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}).formatToParts(new Date(guess));
  const get=k=>Number(parts.find(x=>x.type===k)?.value||0);
  const local=Date.UTC(get('year'),get('month')-1,get('day'),get('hour'),get('minute'),get('second'));
  return (local-guess)/3600000;
}
