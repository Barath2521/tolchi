async function computeChart(y,mo,da,hh,mm,tz,lat,lon){
  const swe = await window.swissReady;
  // Convert the supplied local civil time to UTC using the historically correct
  // offset selected by the UI (the city picker now resolves DST from IANA zones).
  const asUTCms = Date.UTC(y,mo-1,da,hh,mm,0);
  const trueUTCms = asUTCms - tz*3600*1000;
  const u = new Date(trueUTCms);
  const Y=u.getUTCFullYear(), M=u.getUTCMonth()+1, D=u.getUTCDate();
  const hourUT = u.getUTCHours()+u.getUTCMinutes()/60+u.getUTCSeconds()/3600;
  const jd = swe.swe_julday(Y,M,D,hourUT,swe.SE_GREG_CAL);

  const ids = {Sun:swe.SE_SUN, Moon:swe.SE_MOON, Mercury:swe.SE_MERCURY, Venus:swe.SE_VENUS, Mars:swe.SE_MARS, Jupiter:swe.SE_JUPITER, Saturn:swe.SE_SATURN};
  const tropical = {};
  const speeds = {};
  for(const [name,id] of Object.entries(ids)){
    const r=swe.swe_calc_ut(jd,id,swe.SEFLG_SWIEPH|swe.SEFLG_SPEED);
    tropical[name]=r[0]; speeds[name]=r[3];
  }
  const node=swe.swe_calc_ut(jd,swe.SE_MEAN_NODE,swe.SEFLG_SWIEPH|swe.SEFLG_SPEED);
  tropical.Rahu=node[0]; tropical.Ketu=rev(node[0]+180); speeds.Rahu=node[3]; speeds.Ketu=-node[3];

  const ayan=swe.swe_get_ayanamsa_ut(jd);
  const sidereal={};
  for(const [k,v] of Object.entries(tropical)) sidereal[k]=rev(v-ayan);

  // Swiss Ephemeris computes the astronomical ascendant. We use whole-sign
  // houses for Jyotisha, so the sidereal Lagna is enough to assign houses.
  const houses=swe.swe_houses(jd,lat,lon,'W');
  const ascTrop=houses.ascmc ? houses.ascmc[0] : houses.ascendant;
  const ascSidereal=rev(ascTrop-ayan);
  const retro={};
  ['Mercury','Venus','Mars','Jupiter','Saturn'].forEach(p=>retro[p]=speeds[p]<0);

  return {jd,sun:{lon:tropical.Sun},moon:{lon:tropical.Moon},ayan,tropical,sidereal,ascTrop,ascSidereal,retro,utcInstant:u,swiss:true};
}

function signIndex(lon){ return Math.floor(rev(lon)/30); }
function degInSign(lon){ return rev(lon)%30; }
function nakIndex(lon){ return Math.floor(rev(lon)/(360/27)); }
function nakPada(lon){
  const within = rev(lon) - nakIndex(lon)*(360/27);
  return Math.floor(within/(360/27/4))+1;
}
function houseFromLagna(planetSignIdx, lagnaSignIdx){ return ((planetSignIdx-lagnaSignIdx+12)%12)+1; }
function fmtDeg(x){
  const dg = Math.floor(x);
  const m = Math.floor((x-dg)*60);
  return dg+"°"+String(m).padStart(2,'0')+"'";
}
function fmtDate(dt){
  return dt.toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});
}
function addYears(date,years){
  const ms = date.getTime() + years*365.25*86400000;
  return new Date(ms);
}

function buildDashaTimeline(moonSidereal, birthDate){
  const nIdx = nakIndex(moonSidereal);
  const lordIdx = nIdx % 9;
  const lord = DASHA_ORDER[lordIdx];
  const within = moonSidereal - nIdx*(360/27);
  const fracElapsed = within/(360/27);
  const balanceYears = (1-fracElapsed)*DASHA_YEARS[lord];

  const periods = [];
  let start = new Date(birthDate.getTime());
  let end = addYears(start, balanceYears);
  periods.push({lord, start, end, years:balanceYears});
  let idx = lordIdx;
  for(let k=0;k<8;k++){
    idx = (idx+1)%9;
    const L = DASHA_ORDER[idx];
    const yrs = DASHA_YEARS[L];
    const s = new Date(end.getTime());
    const e = addYears(s,yrs);
    periods.push({lord:L, start:s, end:e, years:yrs});
    end = e;
  }
  return periods;
}
function buildAntardashas(mahaLord, mahaStart, mahaYears){
  const startIdx = DASHA_ORDER.indexOf(mahaLord);
  const subs = [];
  let cursor = new Date(mahaStart.getTime());
  for(let k=0;k<9;k++){
    const idx = (startIdx+k)%9;
    const L = DASHA_ORDER[idx];
    const yrs = mahaYears * DASHA_YEARS[L]/120;
    const s = new Date(cursor.getTime());
    const e = addYears(s,yrs);
    subs.push({lord:L,start:s,end:e});
    cursor = e;
  }
  return subs;
}

