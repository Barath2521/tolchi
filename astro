const PLANET_LORD = {Sun:5, Moon:3, Mars:null, Mercury:null, Jupiter:null, Venus:null, Saturn:null};
const SIGN_LORD = [
  'Mars','Venus','Mercury','Moon','Sun','Mercury','Venus','Mars','Jupiter','Saturn','Saturn','Jupiter'
];
const EXALT = {Sun:0,Moon:1,Mars:9,Mercury:5,Jupiter:3,Venus:11,Saturn:6};
const DEBIL = {Sun:6,Moon:7,Mars:3,Mercury:11,Jupiter:9,Venus:5,Saturn:0};
const OWN = {Sun:[4],Moon:[3],Mars:[0,7],Mercury:[2,5],Jupiter:[8,11],Venus:[1,6],Saturn:[9,10]};
const MOOLATRIKONA = {Sun:[0,20],Moon:[3,4],Mars:[0,12],Mercury:[5,20],Jupiter:[8,10],Venus:[6,15],Saturn:[10,20]};
const NATURAL_FRIENDS = {
  Sun:['Moon','Mars','Jupiter'], Moon:['Sun','Mercury'], Mars:['Sun','Moon','Jupiter'],
  Mercury:['Sun','Venus'], Jupiter:['Sun','Moon','Mars'], Venus:['Mercury','Saturn'], Saturn:['Mercury','Venus']
};
const NATURAL_ENEMIES = {
  Sun:['Venus','Saturn'], Moon:[], Mars:['Mercury'], Mercury:['Moon'], Jupiter:['Mercury','Venus'], Venus:['Sun','Moon'], Saturn:['Sun','Moon','Mars']
};

function houseLord(house, lagnaSignIdx){ return SIGN_LORD[(lagnaSignIdx+house-1)%12]; }
function navamsaSignIndex(lon){
  const s=signIndex(lon), n=Math.floor(degInSign(lon)/(30/9));
  const movable=[0,3,6,9], fixed=[1,4,7,10];
  const start=movable.includes(s)?s:(fixed.includes(s)?rev(s+8):rev(s+4));
  return (start+n)%12;
}
function dignityOf(p, sIdx, deg){
  if(p==='Rahu'||p==='Ketu') return 'Node';
  if(EXALT[p]===sIdx) return 'Exalted';
  if(DEBIL[p]===sIdx) return 'Debilitated';
  if(OWN[p]?.includes(sIdx)){
    const mt=MOOLATRIKONA[p];
    if(mt && sIdx===mt[0] && deg<=mt[1]) return 'Moolatrikona';
    return 'Own sign';
  }
  const lord=SIGN_LORD[sIdx];
  if(NATURAL_FRIENDS[p]?.includes(lord)) return 'Friendly sign';
  if(NATURAL_ENEMIES[p]?.includes(lord)) return 'Enemy sign';
  return 'Neutral sign';
}
function combustionThreshold(p){ return {Sun:0,Moon:0,Mars:17,Mercury:14,Jupiter:11,Venus:10,Saturn:15}[p]||0; }
function angularDistance(a,b){ let d=Math.abs(rev(a-b)); return d>180?360-d:d; }
function isCombust(p, sid, sunSid){ return !['Sun','Moon','Rahu','Ketu'].includes(p) && angularDistance(sid,sunSid)<=combustionThreshold(p); }
function aspectOffsets(p){ return p==='Mars'?[4,7,8]:p==='Jupiter'?[5,7,9]:p==='Saturn'?[3,7,10]:[7]; }
function aspectTargets(p, signIdx){ return aspectOffsets(p).map(n=>({house:n,target:(signIdx+n-1)%12})); }
function dashaActivationScore(p, pd, lagnaSignIdx){
  if(!pd) return 0;
  let score=0;
  if([1,5,9,10,11].includes(pd.house)) score+=2;
  if(['Exalted','Moolatrikona','Own sign'].includes(pd.dignity)) score+=2;
  if(pd.dignity==='Debilitated') score-=2;
  if(pd.combust) score-=1;
  const lordHouses=[];
  for(let h=1;h<=12;h++) if(houseLord(h,lagnaSignIdx)===p) lordHouses.push(h);
  if(lordHouses.some(h=>[1,5,9,10,11].includes(h))) score+=2;
  return score;
}
function detectYogas(pd, lagnaSignIdx){
  const by={}; pd.forEach(x=>by[x.name]=x);
  const out=[];
  const benefic=['Jupiter','Venus','Mercury','Moon'];
  if(by.Sun && by.Mercury && by.Sun.signIdx===by.Mercury.signIdx) out.push({name:'Budha-Aditya Yoga',why:'Sun and Mercury occupy the same sign; traditionally associated with intellect, communication and analytical expression.'});
  if(by.Jupiter && by.Moon){
    const rel=(by.Jupiter.signIdx-by.Moon.signIdx+12)%12+1;
    if([5,7,9].includes(rel)) out.push({name:'Gaja-Kesari Yoga',why:'Jupiter is in a kendra from the natal Moon; traditionally read as a supportive combination for judgment, learning and standing.'});
  }
  for(const [p,signs] of Object.entries({Mars:[0,3,6,9],Mercury:[0,3,6,9],Jupiter:[0,3,6,9],Venus:[0,3,6,9],Saturn:[0,3,6,9]})){
    if(by[p] && signs.includes(by[p].signIdx) && ['Exalted','Own sign','Moolatrikona'].includes(by[p].dignity)) out.push({name:`Pancha Mahapurusha — ${p}`,why:`${p} is in a kendra (1/4/7/10) in a strong dignity; traditionally this can amplify the planet's themes.`});
  }
  const lords={}; for(let h=1;h<=12;h++) lords[h]=houseLord(h,lagnaSignIdx);
  if(lords[9]===by[10]?.name && lords[10]===by[9]?.name) out.push({name:'Dharma-Karmadhipati connection',why:'The 9th and 10th house lords exchange ownership roles; traditionally this links fortune/dharma with career/action.'});
  return out;
}
function topicReading(topic, houses, pd, lagnaSignIdx, currentLord){
  const relevant=pd.filter(x=>houses.includes(x.house));
  const lordNames=houses.map(h=>houseLord(h,lagnaSignIdx));
  const lordPlanets=pd.filter(x=>lordNames.includes(x.name));
  const all=[...relevant,...lordPlanets];
  let score=0;
  all.forEach(x=>{score += x.dignity==='Exalted'||x.dignity==='Moolatrikona'||x.dignity==='Own sign'?2:x.dignity==='Debilitated'?-2:0; if([1,5,9,10,11].includes(x.house))score++; if(x.combust)score--; if(x.retro)score+=0;});
  if(currentLord && all.some(x=>x.name===currentLord)) score+=2;
  const level=score>=5?'strongly supported':score>=2?'supported':score<=-3?'under pressure':'mixed';
  const factors=all.slice(0,6).map(x=>`${x.name} in ${SIGNS[x.signIdx].sk} (H${x.house}, ${x.dignity}${x.combust?' · combust':''})`);
  return `<div class="topic"><strong>${topic}: ${level}</strong><div class="muted">Key factors: ${factors.length?factors.join(' · '):'no major natal planet directly occupies these houses'}${currentLord?' · Current Mahadasha: '+currentLord:''}.</div></div>`;
}
function renderDeepAnalysis(chart, planetData, lagnaSignIdx, currentLord){
