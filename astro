    <div class="mini-card"><h3>Yogas detected</h3>${yogas.length?yogas.map(y=>`<div class="topic"><strong>${y.name}</strong><div class="muted">${y.why}</div></div>`).join(''):'<div class="muted">No selected yoga rules triggered strongly enough to display.</div>'}</div>
    <div class="mini-card"><h3>Current Dasha activation</h3><div class="score">${currentLord||'—'}</div><div class="muted">${currentLord&&by[currentLord]?`The current Mahadasha lord is in house ${by[currentLord].house}, ${by[currentLord].dignity.toLowerCase()} and ${by[currentLord].retro?'retrograde':'direct'}.`:'Current period is outside the modeled span.'}</div></div>`;

