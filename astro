    antBox.innerHTML = `<h3 style="font-family:var(--font-display);font-size:15px;color:var(--gold-bright);margin:16px 0 4px;">Antardasha within ${currentPeriod.lord} Mahadasha</h3>
      <ul class="antardasha-list">${subs.map(s=>`<li class="${s===currentSub?'current':''}">${s.lord} — ${fmtDate(s.start)} to ${fmtDate(s.end)}${s===currentSub?' (current)':''}</li>`).join('')}</ul>
      <p class="hint" style="margin-top:8px;">${DASHA_TEXT[currentPeriod.lord]}</p>`;
  } else {
    antBox.innerHTML = `<p class="hint">Current date falls outside the modelled Vimshottari span for this chart.</p>`;
  }

  // ---- Transits (Swiss Ephemeris) ----
  const swe = window.swissEph;
  const transitNow = new Date();
  const nowJD = swe.swe_julday(transitNow.getUTCFullYear(),transitNow.getUTCMonth()+1,transitNow.getUTCDate(),transitNow.getUTCHours()+transitNow.getUTCMinutes()/60+transitNow.getUTCSeconds()/3600,swe.SE_GREG_CAL);
  const nowAyan = swe.swe_get_ayanamsa_ut(nowJD);
  const transitIds = {Sun:swe.SE_SUN, Moon:swe.SE_MOON, Mercury:swe.SE_MERCURY, Venus:swe.SE_VENUS, Mars:swe.SE_MARS, Jupiter:swe.SE_JUPITER, Saturn:swe.SE_SATURN};
  const nowTropical={};
  for(const [name,id] of Object.entries(transitIds)) nowTropical[name]=swe.swe_calc_ut(nowJD,id,swe.SEFLG_SWIEPH|swe.SEFLG_SPEED)[0];
  const nowNode=swe.swe_calc_ut(nowJD,swe.SE_MEAN_NODE,swe.SEFLG_SWIEPH|swe.SEFLG_SPEED)[0];
  nowTropical.Rahu=nowNode; nowTropical.Ketu=rev(nowNode+180);
  document.getElementById('transitAsOf').textContent = `As of ${transitNow.toLocaleString()} (Swiss Ephemeris; houses shown from natal Moon sign / Chandra Rāśi).`;

  const transitTable = document.getElementById('transitTable');
  const rows = planetOrder.map(p=>{
    const sid = rev(nowTropical[p]-nowAyan);
    const sIdx = signIndex(sid);
    const houseFromMoon = houseFromLagna(sIdx, moonSignIdx);
    const good = GOCHARA_GOOD_HOUSES[p]||[];
    let verdict = good.includes(houseFromMoon) ? '<span class="tag good">favorable</span>' : '<span class="tag neutral">neutral / mixed</span>';
    return `<tr><td>${PLANET_GLYPH[p]} ${p}</td><td>${SIGNS[sIdx].sk}</td><td>${fmtDeg(degInSign(sid))}</td><td>${houseFromMoon}</td><td>${verdict}</td></tr>`;
  }).join('');
  transitTable.innerHTML = `<tr><th>Graha</th><th>Transit sign</th><th>Degree</th><th>House from Moon</th><th>Reading</th></tr>` + rows;

  // Sade Sati
  const saturnSid = rev(nowTropical.Saturn-nowAyan);
  const saturnSignIdx = signIndex(saturnSid);
  const rel = (saturnSignIdx-moonSignIdx+12)%12;
  const sadeSatiBox = document.getElementById('sadeSatiBox');
  if(rel===11){ sadeSatiBox.innerHTML = `<p><strong>Sade Sati — rising phase.</strong> Saturn is transiting the 12th sign from your natal Moon, the opening phase of Sade Sati: a good time to simplify commitments and let go of what no longer fits.</p>`; }
  else if(rel===0){ sadeSatiBox.innerHTML = `<p><strong>Sade Sati — peak phase.</strong> Saturn is transiting your natal Moon sign directly, the central and usually heaviest phase: steady discipline and realistic expectations serve better than resistance.</p>`; }
  else if(rel===1){ sadeSatiBox.innerHTML = `<p><strong>Sade Sati — closing phase.</strong> Saturn is transiting the 2nd sign from your natal Moon, the final phase: consolidation of the lessons of the previous seven-odd years, particularly around finances and family.</p>`; }
  else { sadeSatiBox.innerHTML = `<p style="color:var(--lavender);">Saturn is not currently in a Sade Sati position relative to your natal Moon.</p>`; }
}
</script>
</body>
</html>
