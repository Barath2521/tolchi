  const aspectRows=[];
  planetData.filter(p=>!['Rahu','Ketu'].includes(p.name)).forEach(p=>aspectTargets(p.name,p.signIdx).forEach(a=>aspectRows.push(`<tr><td>${PLANET_GLYPH[p.name]} ${p.name}</td><td>${a.house}</td><td>${SIGNS[a.target].sk}</td><td>${a.house===7?'7th aspect':'special '+a.house+'th aspect'}</td></tr>`)));
